# ==========================================
# WhatsApp Insurance Notification Bot - Environment Variables
# ==========================================

# 1. Meta WhatsApp Business Cloud API Configuration
# Obtain from Graph API Explorer or Meta for Developers portal
WHATSAPP_TOKEN=your_permanent_or_temporary_whatsapp_cloud_api_token_here
PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id_here

# 2. Webhook Verification Token
# Must match the token entered in the Meta Developer Portal Webhook configuration
VERIFY_TOKEN=your_custom_webhook_verify_token_here

# 3. Whitelisted Authorized Phone Numbers
# Only these phone numbers will receive notifications and be authorized to query the bot.
# Format: Country code followed by phone number without '+' or spaces (e.g., 905XXXXXXXXX)
RECIPIENT_PHONE_1=905XXXXXXXXX
RECIPIENT_PHONE_2=

# 4. Google Sheets Configuration
# Name of the Google Spreadsheet containing customer and policy records
GOOGLE_SHEET_NAME=SigortaTakipTablosu

# Path to the Google Cloud Service Account JSON key file (default: credentials.json)
GOOGLE_CREDENTIALS_FILE=credentials.json
